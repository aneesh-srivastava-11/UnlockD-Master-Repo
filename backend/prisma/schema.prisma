datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  accounts         Account[]
  categories       Category[]
  expenses         Expense[]
  budgets          Budget[]
  createdGroups    Group[]        @relation("CreatedGroups")
  groupMembers     GroupMember[]
  paidExpenses     GroupExpense[] @relation("PaidExpenses")
  expenseSplits    ExpenseSplit[]
  settlementsFrom  Settlement[]   @relation("SettlementFrom")
  settlementsTo    Settlement[]   @relation("SettlementTo")
  importedTransactions ImportedTransaction[]
}

model Account {
  id        String   @id @default(uuid())
  name      String
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  sentTransactions     Transaction[] @relation("FromAccount")
  receivedTransactions Transaction[] @relation("ToAccount")
  expenses             Expense[]
  importedTransactions ImportedTransaction[]
}

model Transaction {
  id              String            @id @default(uuid())
  fromAccountId   String
  toAccountId     String
  amount          Decimal           @db.Decimal(19, 4)
  status          TransactionStatus
  idempotencyKey  String            @unique
  createdAt       DateTime          @default(now())
  description     String?
  categoryId      String?

  fromAccount     Account           @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account           @relation("ToAccount", fields: [toAccountId], references: [id])
  category        Category?         @relation(fields: [categoryId], references: [id])
  settlement      Settlement?
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  name         String
  createdAt    DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  expenses     Expense[]
  budgets      Budget[]
  transactions Transaction[]
  importedTransactions ImportedTransaction[]

  @@unique([userId, name])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String
  amount      Decimal  @db.Decimal(19, 4)
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  account     Account  @relation(fields: [accountId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  importedTransaction ImportedTransaction?
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(19, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  category     Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

enum ImportStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

model Group {
  id         String   @id @default(uuid())
  name       String
  createdBy  String
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  settledAt  DateTime?

  creator      User            @relation("CreatedGroups", fields: [createdBy], references: [id])
  members      GroupMember[]
  expenses     GroupExpense[]
  settlements  Settlement[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id])
  user     User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupExpense {
  id           String   @id @default(uuid())
  groupId      String
  paidByUserId String
  description  String
  amount       Decimal  @db.Decimal(19, 4)
  createdAt    DateTime @default(now())

  group        Group          @relation(fields: [groupId], references: [id])
  paidBy       User           @relation("PaidExpenses", fields: [paidByUserId], references: [id])
  splits       ExpenseSplit[]
}

model ExpenseSplit {
  id             String  @id @default(uuid())
  groupExpenseId String
  userId         String
  shareAmount    Decimal @db.Decimal(19, 4)

  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([groupExpenseId, userId])
}

model Settlement {
  id            String           @id @default(uuid())
  groupId       String
  fromUserId    String
  toUserId      String
  amount        Decimal          @db.Decimal(19, 4)
  status        SettlementStatus @default(PENDING)
  transactionId String?          @unique
  createdAt     DateTime         @default(now())
  settledAt     DateTime?

  group        Group       @relation(fields: [groupId], references: [id])
  fromUser     User        @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser       User        @relation("SettlementTo", fields: [toUserId], references: [id])
  transaction  Transaction? @relation(fields: [transactionId], references: [id])
}

model ImportedTransaction {
  id                  String       @id @default(uuid())
  userId              String
  accountId           String
  source              String
  rawDescription      String
  merchant            String?
  amount              Decimal      @db.Decimal(19, 4)
  date                DateTime
  suggestedCategoryId String?
  isRecurring         Boolean      @default(false)
  status              ImportStatus @default(PENDING_REVIEW)
  linkedExpenseId     String?      @unique
  createdAt           DateTime     @default(now())

  user                User      @relation(fields: [userId], references: [id])
  account             Account   @relation(fields: [accountId], references: [id])
  suggestedCategory   Category? @relation(fields: [suggestedCategoryId], references: [id])
  linkedExpense       Expense?  @relation(fields: [linkedExpenseId], references: [id])
}
